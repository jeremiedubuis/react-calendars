{
    "name": "react-calendars",
    "keywords": [
        "react",
        "datepicker",
        "calendar",
        "date"
    ],
    "version": "2.0.0",
    "description": "A react calendar and datepicker library",
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "main": "./dist/react-calendars.umd.js",
    "module": "./dist/react-calendars.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/react-calendars.es.js",
            "require": "./dist/react-calendars.umd.js"
        }
    },
    "repository": "git@github.com:jeremiedubuis/react-calendars.git",
    "author": "Jérémie Dubuis <jeremie.dubuis@gmail.com>",
    "license": "MIT",
    "private": false,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint -c eslint.config.mjs . --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint -c eslint.config.mjs . --ext .js,.jsx,.ts,.tsx --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": "^16 || ^17 || ^18 || ^19",
        "react-dom": "^16 || ^17 || ^18 || ^19"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "@vitejs/plugin-react": "^4.0.3",
        "@testing-library/jest-dom": "^6.4.5",
        "@testing-library/react": "^14.2.1",
        "eslint": "^9.37.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^16.4.0",
        "jsdom": "^24.0.0",
        "prettier": "^3.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "vitest": "^1.6.0",
        "typescript": "^5.9.3",
        "vite": "^4.4.6",
        "vite-plugin-dts": "^3.9.1"
    }
}
